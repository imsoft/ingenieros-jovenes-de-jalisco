# Copia este archivo como .env.local y completa los valores.

# Supabase → Project Settings → API. La anon key es pública; nunca uses aquí la service role key.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Correos del Consejo que reciben el aviso de cada nueva solicitud (separados por comas).
# Los que terminan en .example se ignoran.
NOTIFICACIONES_CORREO=consejo@ingenierosjovenes.example

# Resend (correos de la app: aviso al Consejo, bienvenida al aprobar, confirmación de eventos).
# Sin estas dos variables no se envía ningún correo y el sitio funciona igual.
# El remitente debe usar un dominio verificado en Resend.
RESEND_API_KEY=
CORREO_REMITENTE="Ingenieros Jóvenes de Jalisco <no-responder@ingenierosjovenes.example>"

# URL pública del sitio (canónicas, sitemap, imagen para compartir y datos estructurados).
# En Vercel: déjala vacía para usar el dominio de producción automáticamente, o pon el dominio propio
# cuando exista (ej. https://ingenierosjovenes.example). Nunca copies aquí el valor de localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Código de verificación de Google Search Console (método "etiqueta HTML"), solo el valor de content.
GOOGLE_SITE_VERIFICATION=

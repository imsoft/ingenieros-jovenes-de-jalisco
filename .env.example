# Copia este archivo como .env.local y completa los valores.

# Supabase → Project Settings → API. La anon key es pública; nunca uses aquí la service role key.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Correo provisional que recibirá los avisos de nuevas solicitudes (el envío se conecta en la fase 2).
NOTIFICACIONES_CORREO=consejo@ingenierosjovenes.example

# URL pública del sitio (para metadatos y enlaces).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

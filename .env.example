# Copy this file to .env.local and fill in the values. Never put real keys in this file.

# Supabase → Project Settings → API. The anon/publishable key is public; never use the secret (service role) key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Consejo emails that receive a notice for every new membership application (comma-separated).
# Addresses ending in .example are ignored.
BOARD_NOTIFICATION_EMAILS=consejo@ingenierosjovenes.example

# Resend (app emails: notice to the Consejo, welcome on approval, event confirmation).
# Without these two variables no email is sent and the site works the same.
# The sender must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Ingenieros Jóvenes de Jalisco <no-responder@ingenierosjovenes.example>"

# Public site URL (canonicals, sitemap, share image and structured data).
# On Vercel: leave it empty to use the production domain automatically, or set the custom domain
# once it exists (e.g. https://ingenierosjovenes.example). Never copy the localhost value there.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console verification code ("HTML tag" method), only the content value.
GOOGLE_SITE_VERIFICATION=
